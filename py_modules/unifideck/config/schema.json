{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/src893/unifideck/config.schema.json",
  "title": "Unifideck Configuration Schema",
  "description": "JSON Schema for defaults/config.json and user overrides. Strict mode (additionalProperties: false) everywhere to 
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paths",
    "stores",
    "dedup"
  ],
  "properties": {
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_dir",
        "cache_dir"
      ],
      "properties": {
        "data_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "cache_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "steam_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1
        },
        "games_map": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sd_card_root": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "cache_ttl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steam_metadata": {
          "$ref": "#/$defs/positiveInt"
        },
        "compat": {
          "$ref": "#/$defs/positiveInt"
        },
        "metacritic_metadata": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artwork_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "dedup": {
      "type": "object",
      "additionalProperties": false,
      "required": [

        "tracked_stores"
      ],
      "description": "Cross-store + Steam-native deduplication settings.",
      "properties": {
        "tracked_stores": {
          "type": "array",
          "description": "Stores subject to dedup, in priority order (first wins on install-status ties). Stores absent from this l
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "custom_path": {
          "type": "string"
        }
      }
    },
    "cli_timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth_check": {
          "$ref": "#/$defs/positiveInt"
        },
        "version_check": {
          "$ref": "#/$defs/positiveInt"
        },
        "library_fetch": {
          "$ref": "#/$defs/positiveInt"
        },
        "install_poll": {
          "$ref": "#/$defs/positiveInt"
        },
        "uninstall": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "stores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gog",
        "epic",
        "amazon",
        "ubisoft",
        "microsoft"
      ],
      "properties": {
        "gog": {
          "$ref": "#/$defs/gogStore"
        },
        "epic": {
          "$ref": "#/$defs/epicStore"
        },
        "amazon": {
          "$ref": "#/$defs/amazonStore"
        },
        "ubisoft": {
          "$ref": "#/$defs/ubisoftStore"
        },
        "microsoft": {
          "$ref": "#/$defs/microsoftStore"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metacritic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "composer_url": {

              "$ref": "#/$defs/httpsUrl"
            },
            "fetch_timeout_seconds": {
              "$ref": "#/$defs/positiveInt"
            }
          }
        },
        "unifidb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cdn_base": {
              "$ref": "#/$defs/httpsUrl"
            },
            "match_threshold": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "fetch_timeout_seconds": {
              "$ref": "#/$defs/positiveInt"
            }
          }
        },
        "steam_store": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "search_url": {
              "$ref": "#/$defs/httpsUrl"
            },
            "search_timeout_seconds": {
              "$ref": "#/$defs/positiveInt"
            }
          }
        }
      }
    },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steamgriddb_api_key": {
          "type": "string"
        },
        "steamgriddb_api_base": {
          "$ref": "#/$defs/httpsUrl"
        },
        "download_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "failure_cooldown_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "cdp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "eval_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "response_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poll_interval_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }

    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "root": {
          "type": "string"
        },
        "tolerance_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "sync_wait_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "failure_behavior": {
          "type": "object",
          "description": "Per-store policy for cloud sync failures at game launch. Values: 'silent' (log only, no UI) or 'toast' (d
          "additionalProperties": false,
          "properties": {
            "default": {
              "$ref": "#/$defs/cloudFailureBehavior"
            },
            "epic": {
              "$ref": "#/$defs/cloudFailureBehavior"
            },
            "gog": {
              "$ref": "#/$defs/cloudFailureBehavior"
            },
            "amazon": {
              "$ref": "#/$defs/cloudFailureBehavior"
            },
            "ubisoft": {
              "$ref": "#/$defs/cloudFailureBehavior"
            }
          }
        }
      }
    },
    "logs": {
      "type": "object",
      "description": "Per-launch log archive. Each launcher dispatcher run writes to an archive file keyed by correlation ID, prune
      "additionalProperties": false,
      "properties": {
        "archive_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "export_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "description": "Per-game launch failure protection. When a game fails to launch failures_threshold times within window_second
      "additionalProperties": false,
      "properties": {
        "failures_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "fast_boot_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "disk_space": {
      "type": "object",
      "description": "Pre-launch disk space verification. Before each cloud save sync, the launcher checks free space on the user-d

      "additionalProperties": false,
      "properties": {
        "min_free_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "size_multiplier": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 100.0
        },
        "size_cache_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "size_cache_ttl_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protondb_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "deck_verified_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "browser_poll_interval_seconds": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 60.0
        },
        "browser_oauth_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_filename": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "Frontend-facing preferences. `locale` drives the React i18next selection and is persisted to disk when the us
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probe_to_features": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "probe_to_handlers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"

            }
          }
        }
      }
    },
    "proton": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "shortcuts_registry_path": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "binary_resolver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version_check_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locales": {
          "type": "array",
          "description": "List of locale entries, format intentionally loose to allow build-time extension without schema updates",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audit_log_capacity": {
          "type": "integer",
          "minimum": 10,
          "maximum": 10000
        },
        "bruteforce_window_seconds": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 3600.0
        },
        "bruteforce_warning_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "bruteforce_escalation_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "token_files_to_wipe_on_reset": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 0
    },
    "cloudFailureBehavior": {
      "type": "string",

      "enum": [
        "silent",
        "toast"
      ],
      "description": "Cloud sync failure UI policy. 'silent' logs only, 'toast' shows a dismissable banner. A blocking 'prompt' mod
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[a-zA-Z0-9.-]+(/.*)?$"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://[a-zA-Z0-9.-]+(/.*)?$"
    },
    "gogStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "auth_url",
        "token_url",
        "token_file"
      ],
      "properties": {
        "client_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "client_secret": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "token_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "redirect_uri": {
          "$ref": "#/$defs/httpsUrl"
        },
        "allowed_redirect_uris": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpsUrl"
          },
          "minItems": 1
        },
        "base_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "api_gog_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "token_file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "gogdl_config_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "download_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "token_refresh_threshold_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "supported_languages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "minItems": 1
        },
        "user_agent": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "epicStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_binary_search_paths",
        "user_file"
      ],

      "properties": {
        "cli_binary_search_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1
        },
        "cli_version_flag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "user_file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "default_install_root": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth_redirect_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpsUrl"
          },
          "minItems": 1
        },
        "auth_url_markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "info_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "list_updates_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "installed_cache_ttl_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "size_cache_ttl_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "amazonStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_binary_search_paths",
        "user_file"
      ],
      "properties": {
        "cli_binary_search_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1
        },
        "cli_version_flag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nile_config_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "user_file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "default_install_root": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth_redirect_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpsUrl"
          },
          "minItems": 1
        },
        "nile_register_success_markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },

        "list_updates_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "get_size_timeout_seconds": {
          "$ref": "#/$defs/positiveInt"
        }
      }
    },
    "ubisoftStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_dir",
        "prefixes_dir"
      ],
      "properties": {
        "data_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "id_map_file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "visible_games_file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "prefixes_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "installer_cache_dir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upc_session_file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "game_id_db_file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "default_install_base": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sdcard_install_base": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "template_prefix_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth_prefix_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth_shortcut_store_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth_shortcut_launch_wait_ms": {
          "$ref": "#/$defs/positiveInt"
        },
        "installer_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "installer_filename": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "bootstrap_marker": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "game_id_db_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "game_id_db_max_age_seconds": {
          "$ref": "#/$defs/positiveInt"
        },
        "upc_relative_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upc_connect_relative_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "configurations_relative_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ownership_relative_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "upc_credential_files": {
          "type": "array",

          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "wine_system_users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1
        },
        "filter_steam_linked": {
          "type": "boolean"
        },
        "steam_library_cross_ref": {
          "type": "boolean"
        }
      }
    },
    "microsoftStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "token_file",
        "auth_url",
        "token_url"
      ],
      "properties": {
        "client_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "token_file": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "auth_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "token_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "redirect_uri": {
          "$ref": "#/$defs/httpsUrl"
        },
        "allowed_redirect_uris": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpsUrl"
          },
          "minItems": 1
        },
        "xbl_auth_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "xsts_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "xcloud_catalog_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "xcloud_titles_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "xcloud_launch_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "gssv_relying_party": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subscription_check_url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    }
  }
}